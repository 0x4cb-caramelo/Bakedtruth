# ===================================================================
# .env.example — Brot Markets
#
# Every variable this repository reads, with a placeholder or a safe default. Copy the part you need into a file
# OUTSIDE the repository (or into app/.env.local for the site) and fill it there. Never commit a filled file, and
# never paste a key into a chat. The keypairs are files whose PATHS you set here; the files stay outside the repo.
# ===================================================================

# --- Site (app/): read in the browser, so NEXT_PUBLIC_ values are public ---------------------------------
# The Solana RPC the browser reads from. The public devnet endpoint works for development; a keyed endpoint
# belongs in your own environment, never in a committed file.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# The cluster the site runs on: devnet, testnet or mainnet-beta.
NEXT_PUBLIC_CLUSTER=devnet
# The read API (services/api). Locally, run it on 127.0.0.1:4220.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4220

# --- Read API (services/api) -----------------------------------------------------------------------------
# The RPC the API reads the chain through. A secret when it carries a key.
API_RPC_URL=https://api.devnet.solana.com
API_CLUSTER=devnet
# Loopback only. Put a tunnel or proxy in front of it; do not bind a public address.
API_HOST=127.0.0.1
API_PORT=4220
# Milliseconds between chain snapshots.
API_REFRESH_MS=15000
# The site's origin for CORS. "*" is safe for public read-only data.
API_CORS_ORIGIN=*

# --- Keeper (services/keeper): the server holds the real values; these are the names only ----------------
# The RPC URL. A secret: it carries the provider's key.
KEEPER_RPC_URL=
# The keeper's keypair file (a 64-byte JSON array), outside the repository.
KEEPER_KEYPAIR=
KEEPER_CLUSTER=devnet
KEEPER_CYCLE_MS=60000
# 1 simulates and never sends.
KEEPER_DRY_RUN=0
KEEPER_HEALTH_HOST=127.0.0.1
KEEPER_HEALTH_PORT=4210
# The restart secret of POST /restart: a file, never an inline value. Only the primary on the server sets it.
KEEPER_RESTART_SECRET_FILE=
# Standby keys (deferred to after the hackathon): see services/keeper/.env.example.

# --- Devnet scripts (scripts/): the wallets the seed and smoke scripts use ----------------------------------
# A devnet wallet file (a keypair), outside the repository.
DEVNET_WALLET=
# The team's own key, for the team's acts (scripts/team/). Never the upgrade key.
TEAM_KEYPAIR=
# A keyed devnet RPC, if the public endpoint rate-limits you.
DEVNET_RPC_URL=
