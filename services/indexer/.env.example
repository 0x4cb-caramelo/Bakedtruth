# brot-indexer settings (Sprint 08). Copy outside the repository (on the server: /etc/brot-markets/indexer.env,
# root-owned, mode 0640). Never commit a filled file. The indexer logs counts and error names only, never a URL.
# The RPC of the indexer's own account (TP §3.5; D4). A secret: it usually carries the key. On the server it is a
# credential file (the unit sets INDEXER_RPC_URL_FILE through LoadCredential=, T13); INDEXER_RPC_URL itself is for a
# development machine only.
INDEXER_RPC_URL=
# Optional: the WebSocket for the logsSubscribe wake-up (a hint only; the ingest reads at finalized either way). Unset,
# it is INDEXER_RPC_URL over ws(s) (right for Helius and the public devnet; a local validator listens on the RPC port
# plus one). "off" turns the wake-up off. A secret when it carries a key: INDEXER_WS_URL_FILE on the server.
INDEXER_WS_URL=
# The SQLite file, outside the repository (on the server: /var/lib/brot-indexer/indexer.sqlite). No default.
INDEXER_DB_PATH=
# How often the ingest polls (proposal §2.7: 15 to 30 s), and how often the sponsored feeds are read for feed_history
# (15 s sees every devnet update; mainnet needs 5 s or less, Sprint 18), in milliseconds.
INDEXER_POLL_MS=15000
INDEXER_FEED_POLL_MS=15000
# Every RPC call's timeout, in milliseconds.
INDEXER_TIMEOUT_MS=20000
# The read routes: loopback only (TP §3.5, port 4201); a tunnel or proxy in front, never a public bind.
INDEXER_API_HOST=127.0.0.1
INDEXER_API_PORT=4201
# The site's origin for CORS. "*" is safe for public read-only data.
INDEXER_CORS_ORIGIN=*
# Optional: the launch partners file. Default: the release's content/partners.json, read again before each refresh.
INDEXER_PARTNERS_FILE=
