# Configuration of the "coming soon" site. None of these is a secret.
# On the server this file is /etc/brot-markets/landing.env (root:brot, 0640).

# Where the server listens. Always localhost: the Cloudflare tunnel is the only way in.
HOST=127.0.0.1
PORT=4200

# The public address. Waitlist requests from a browser are accepted only from this origin.
SITE_ORIGIN=https://brot.markets

# The waitlist file (one JSON line per lead). Must be writable by the service user only.
LEADS_FILE=/var/lib/brot-markets/leads/leads.jsonl
