# Keeper settings. Copy to a file outside the repository on the server (root-owned, 0600) and fill the values there.
# Never commit a filled file; `.env*` is ignored by git.
#
# Secrets are systemd credentials (TP §11, T13), not lines of this file: deploy/vps/brot-keeper.service loads the
# keypair, the RPC URL and the restart secret with LoadCredential= and points KEEPER_KEYPAIR, KEEPER_RPC_URL_FILE and
# KEEPER_RESTART_SECRET_FILE at them. A value in this file overrides the unit's own Environment= line, so on the
# server leave those variables out. The plain variables below are for a development machine.

# RPC URL of the cluster (Helius, in the MVP). A secret: it carries the API key. KEEPER_RPC_URL_FILE (a credential
# file) wins over KEEPER_RPC_URL.
KEEPER_RPC_URL=
KEEPER_RPC_URL_FILE=
# Path to the keeper's keypair (64-byte JSON array), outside the repository.
KEEPER_KEYPAIR=
# devnet or local
KEEPER_CLUSTER=devnet
# Milliseconds between cycles.
KEEPER_CYCLE_MS=60000
# 1 = simulate and log what would be sent; never sends.
KEEPER_DRY_RUN=0
# Health endpoint: loopback only.
KEEPER_HEALTH_HOST=127.0.0.1
KEEPER_HEALTH_PORT=4210

# Settlement (Sprint 06 DoD): on = the keeper also tallies, finalizes after the review window, pays every entry, the
# creator share and the prize, collects the fee, closes and sweeps. Off (the default) reports the pending work on
# /healthz and sends nothing for it. Whether the devnet keeper pays is the founder's decision: leave it off until then.
KEEPER_SETTLE=off
# Settle instructions per transaction, at most 12 (12 settle_entry fit 1,232 bytes).
KEEPER_SETTLE_BATCH=10
# The fee vault is swept to the fee recipient only above this many lamports over its rent (0.01 SOL). [AC]
KEEPER_SWEEP_MIN_LAMPORTS=10000000
# Priority fee, micro-lamports per compute unit: the floor, the ceiling (each kind of instruction also has its own,
# lower for settlement), and the most one transaction may pay in lamports (0.001 SOL). [AC]
KEEPER_PRIORITY_FEE_FLOOR=0
KEEPER_PRIORITY_FEE_CEILING=1000000
KEEPER_PRIORITY_FEE_MAX_LAMPORTS=1000000

# Alerts (deploy/vps/runbooks/). [AC] marks working values to confirm with the founder.
# open_campaigns at or above this share of max_open_campaigns, in basis points (80%).
KEEPER_OPEN_CAMPAIGNS_ALERT_BPS=8000
# The SOL in every campaign's vault above which exposure_high fires, in lamports (100 SOL). [AC]
KEEPER_EXPOSURE_ALERT_LAMPORTS=100000000000
# Openings in the last hour above which openings_per_hour_high fires. [AC]
KEEPER_OPENINGS_PER_HOUR_MAX=20
# campaign_idle: a resolvable campaign still open after 10 minutes; a settling one unchanged for 30.
KEEPER_IDLE_RESOLVABLE_MS=600000
KEEPER_IDLE_SETTLING_MS=1800000
# The keeper wallet's SOL floor, in lamports (0.5 SOL). An assumption to confirm with the founder.
KEEPER_SOL_FLOOR_LAMPORTS=500000000

# Sprint 07: standby mode and the watchdog. Every value is a placeholder; the real ones live outside the repository.
# primary (default) or standby. A primary with KEEPER_RESTART_SECRET_FILE set also serves POST /restart.
KEEPER_MODE=primary
# Standby only: the primary's ops address (GET /healthz, POST /restart). Placeholder, never the real host.
KEEPER_PRIMARY_URL=
# Standby only: the second RPC company, for the second read. Empty turns the second read off. A secret like the
# first: KEEPER_RPC_URL_B_FILE (a credential file) wins. The journal names only its origin.
KEEPER_RPC_URL_B=
KEEPER_RPC_URL_B_FILE=
# Both modes: the HMAC secret of POST /restart, a root-owned file (a systemd credential). Never inline.
KEEPER_RESTART_SECRET_FILE=
# Primary: the flag file POST /restart writes; the root-owned path unit restarts the keeper when it appears.
# The unit of deploy/vps/ sets /run/brot-keeper/restart.flag (its own runtime directory).
KEEPER_RESTART_FLAG=/run/brot-markets/restart.flag
# Standby: the review queue (JSON lines) for second-read mismatches and unchecked resolutions.
KEEPER_REVIEW_QUEUE=/var/lib/brot-markets/review-queue.jsonl
# Standby: the continuous feed watcher's interval, for open price campaigns.
KEEPER_WATCH_MS=5000
# Standby: the watchdog's probe interval (5 minutes), the silence before a restart (10 minutes) and the restarts (3).
KEEPER_WATCHDOG_MS=300000
KEEPER_TAKEOVER_AFTER_MS=600000
KEEPER_RESTART_TRIES=3
