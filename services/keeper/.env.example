# Keeper settings. Copy to a file outside the repository on the server (root-owned, 0600) and fill the values there.
# Never commit a filled file; `.env*` is ignored by git.

# RPC URL of the cluster (Helius, in the MVP). A secret: it carries the API key.
KEEPER_RPC_URL=
# Path to the keeper's keypair (64-byte JSON array), outside the repository.
KEEPER_KEYPAIR=
# devnet or local
KEEPER_CLUSTER=devnet
# Seconds between cycles, in milliseconds.
KEEPER_CYCLE_MS=60000
# 1 = simulate and log what would be sent; never sends.
KEEPER_DRY_RUN=0
# Health endpoint: loopback only.
KEEPER_HEALTH_HOST=127.0.0.1
KEEPER_HEALTH_PORT=4210
