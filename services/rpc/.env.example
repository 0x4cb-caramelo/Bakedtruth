# brot-rpc settings (Sprint 08). Copy outside the repository (on the server: /etc/brot-markets/rpc.env, root-owned,
# mode 0640). Never commit a filled file.
# The upstream RPC of the relay's own account (T14), with a hard spending limit set at the provider. A secret: it
# usually carries the key. The relay never logs it.
RELAY_UPSTREAM_URL=
# Loopback only; the tunnel's /rpc route reaches it.
RELAY_HOST=127.0.0.1
RELAY_PORT=4202
# Optional: a CORS origin, when the relay is not served on the site's own origin (local development). Empty: none.
RELAY_CORS_ORIGIN=
# The largest body accepted, in bytes.
RELAY_BODY_MAX=8192
# The weighted token bucket per client (an IP, or an IPv6 /64): credits earned per second and the most held.
RELAY_RATE_PER_SECOND=20
RELAY_BURST=120
# Credits the relay may spend upstream per UTC day, every client together. Size it to the account's plan.
RELAY_DAILY_BUDGET=500000
# How long a campaign, config or metric account answer is reused, in milliseconds (never an entry or a status).
RELAY_CACHE_MS=1500
RELAY_UPSTREAM_TIMEOUT_MS=10000
# Countries (two letters, comma-separated, as Cloudflare's CF-IPCountry sends them) whose joins and openings are
# refused. Empty for now (the founder, 2026-10-11): nothing is blocked. Filled only on the founder's decision (K-11),
# and only once CF-IPCountry is shown to reach the server through the tunnel (TP §14.4 C9).
GEO_BLOCK_COUNTRIES=
