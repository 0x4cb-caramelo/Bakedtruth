# Read API settings (Sprint 08, hackathon MVP). Copy outside the repository on the machine that runs it.
# RPC URL of the cluster. A secret if it carries a key; never commit a filled file.
API_RPC_URL=
# devnet or local
API_CLUSTER=devnet
# Loopback only. The API is read-only; put a tunnel or proxy in front of it, not a public bind.
API_HOST=127.0.0.1
API_PORT=4220
# Seconds between chain snapshots, in milliseconds.
API_REFRESH_MS=15000
# The site's origin for CORS. "*" allows any origin, which is safe for public read-only data.
API_CORS_ORIGIN=*
# The leaderboard reads the program's transactions: at most this many per refresh (Sprint 13). Optional.
API_HISTORY_PER_REFRESH=200
# Optional (Sprint 13): a file on the server, outside the repository, listing wallets left out of the leaderboard at
# their owner's request (a JSON array of addresses). Never commit it. See services/api/README.md.
API_LEADERBOARD_HIDDEN=
# Optional (Sprint 13): a separate RPC for the leaderboard's history, so its reads never spend the snapshot's rate limit
# (the public devnet RPC answers 429 under load). A secret when it carries a key.
API_HISTORY_RPC_URL=
# Optional (Sprint 08): the reviewed account names served at /api/v1/names. Default: the repository's
# content/account-names.json, read again on every refresh.
API_NAMES_FILE=
# Optional (Sprint 08): how often the display price (/api/v1/price) is read, in milliseconds. Default 180000.
API_PRICE_REFRESH_MS=180000
# Optional (Sprint 08): CoinGecko for the display price (on), or Pyth SOL/USD only (off, the default). Off until the
# founder's decision on CoinGecko's terms (the legal review of 2026-10-11: on no plan can they be met today). Display
# only; the program never reads it. CoinGecko's terms ask for "Powered by CoinGecko" wherever its data is shown.
API_COINGECKO=off
# Optional: a CoinGecko key (a secret; never commit a filled file) and its plan: demo (the free Demo plan, 10,000 calls
# a month: keep API_PRICE_REFRESH_MS at 300000 or more) or pro. Empty: the keyless API, which CoinGecko says is not for
# production or scheduled polling.
API_COINGECKO_KEY=
API_COINGECKO_PLAN=demo
