# Read API settings (Sprint 08, hackathon MVP). Copy outside the repository on the machine that runs it.
# RPC URL of the cluster. A secret if it carries a key; never commit a filled file.
API_RPC_URL=
# devnet or local
API_CLUSTER=devnet
# Loopback only. The API is read-only; put a tunnel or proxy in front of it, not a public bind.
API_HOST=127.0.0.1
API_PORT=4220
# Seconds between chain snapshots, in milliseconds.
API_REFRESH_MS=15000
# The site's origin for CORS. "*" allows any origin, which is safe for public read-only data.
API_CORS_ORIGIN=*
# The leaderboard reads the program's transactions: at most this many per refresh (Sprint 13). Optional.
API_HISTORY_PER_REFRESH=200
# Optional (Sprint 13): a file on the server, outside the repository, listing wallets left out of the leaderboard at
# their owner's request (a JSON array of addresses). Never commit it. See services/api/README.md.
API_LEADERBOARD_HIDDEN=
