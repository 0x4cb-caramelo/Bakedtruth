{
  "name": "brot-markets",
  "version": "0.1.0",
  "private": true,
  "description": "Brot Markets: On-Chain Campaigns on Solana, answered by reading on-chain accounts",
  "author": "Ronaldo Pereira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcf07/pred-provable.git"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "app",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:program": "cargo build-sbf --manifest-path programs/brot-markets/Cargo.toml --sbf-out-dir target/deploy -- --locked && cargo build-sbf --manifest-path tests/programs/cpi-proxy/Cargo.toml --sbf-out-dir target/deploy -- --locked && bun run idl",
    "idl": "bun run scripts/build-idl.ts",
    "slot-matrix": "bun scripts/slot-matrix.ts",
    "test": "bun test tests/",
    "test:rust": "SBF_OUT_DIR=$PWD/target/deploy cargo test -p brot-markets --features no-entrypoint",
    "smoke:devnet": "bun run scripts/devnet-smoke.ts",
    "seed:devnet": "bun run scripts/devnet-seed.ts",
    "deploy:devnet": "bun run scripts/deploy/devnet-deploy.ts",
    "deploy:rehearse": "bun run scripts/deploy/rehearse.ts",
    "team:rehearse": "bun run scripts/team/rehearse.ts",
    "validator:negative": "bun run scripts/validator/negative-run.ts",
    "dev": "bun --filter @pred-provable/app dev",
    "lint": "prettier --check \"tests/**/*.ts\" \"scripts/**/*.ts\" \"packages/**/*.ts\" && bun run lint:sdk",
    "test:os": "node scripts/run-tests.js",
    "self-test": "node scripts/os-self-test.js",
    "codemap": "node scripts/codemap.js",
    "prepare": "git config core.hooksPath .husky || echo \"git hooks not installed (not a git repository?)\"",
    "lint:sdk": "bunx --bun depcruise packages/sdk/src services --config .dependency-cruiser.cjs && tsc -p packages/sdk --noEmit && bun scripts/sdk-portability.ts"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@brot/sdk": "workspace:*",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@solana/kit": "~8.4.0",
    "@solana/kit-plugin-litesvm": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "@solana/web3.js": "^1.99.0",
    "@types/bun": "^1.4.2",
    "codama": "1.11.0",
    "dependency-cruiser": "18.4.0",
    "litesvm": "^1.5.0",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
