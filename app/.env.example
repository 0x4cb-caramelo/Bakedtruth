# Public RPC endpoint used by the browser. Defaults to devnet when unset.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Cluster for explorer links: devnet, testnet or mainnet-beta.
NEXT_PUBLIC_CLUSTER=devnet
# The read API (services/api). Locally, run it on 127.0.0.1:4220.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4220
# A-8: the program deploy (ProgramData's slot) the site is built for. Leave it unset: the build reads it once through
# NEXT_PUBLIC_RPC_URL and prints it. Set it only to pin a build to a known deploy; an empty or non-numeric value makes
# that build refuse to sign. Build the site again after every program upgrade.
# NEXT_PUBLIC_PROGRAM_DEPLOY_SLOT=509389614
