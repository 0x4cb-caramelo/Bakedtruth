{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./app/*"] }
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts", "packages/**/*.ts", "services/**/*.ts"]
}
